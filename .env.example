# Supabase Configuration
# Replace these placeholder values with your Supabase project credentials

SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="https://your_project_id.supabase.co"

# Client-accessible variables (Vite prefixed)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Optional Server-Side Admin Role Key (for server functions / admin seeding)
# NEVER expose this key to client-side code
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
