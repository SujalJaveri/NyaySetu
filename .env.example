# Supabase Configuration
# Replace these placeholder values with your Supabase project credentials

SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="https://your_project_id.supabase.co"

# Client-accessible variables (Vite prefixed)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Optional Server-Side Admin Role Key (for server functions / admin seeding)
# NEVER expose this key to client-side code
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Optional AI / LLM Configuration
# Set either OPENAI_API_KEY, GEMINI_API_KEY, or CUSTOM_LLM_URL to enable AI features.
OPENAI_API_KEY="your_openai_api_key"
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.5-flash"    # E.g. "gemini-3.5-flash"

# To use a local or custom LLM (e.g. Ollama, LM Studio, vLLM)
CUSTOM_LLM_URL=""      # E.g. "http://localhost:11434/v1"
CUSTOM_LLM_KEY=""      # API key if required by your local endpoint
CUSTOM_LLM_MODEL=""    # E.g. "llama3" or "mistral"

